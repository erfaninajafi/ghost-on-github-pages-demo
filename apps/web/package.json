{
  "name": "@expertsacademy/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write app components lib tests *.ts *.json *.mjs",
    "format:check": "prettier --check app components lib tests *.ts *.json *.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.2.8",
    "next": "15.5.27",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "2.17.0"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "autoprefixer": "10.4.24",
    "postcss": "8.5.8",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.19",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
